#include <cstdint>
#include <unordered_map>
#include <vector>

#include "il/il.h"

namespace bronze::lower {

// Which blocks of `fn` lie in a natural loop (index = block id).
std::vector<uint8_t> loopBlocks(const il::Function& fn);

// The module function a call made at `inst` in function `fn` would enter, as
// far as the IL names it; UINT32_MAX when it names none. A guess, read only by
// the inliner's choice of WHERE to copy bodies (inline_guarded.cpp): every copy
// stands behind the guard its call would have taken, so a wrong answer costs
// code, never meaning.
//  - `call @F` (a direct call, closures by their env hops included): F;
//  - a resolved method, getter or setter site (`directTarget`): the body the
//    site was pointed at;
//  - `call.dynamic` of a closure read from the environment record its caller
//    closed over (`function walk(n) { for (...) walk(c); }` nested in another
//    function, or a sibling declaration): the function whose closure the
//    enclosing function stores in that slot, when it stores one and only one.
class CallTargets {
public:
    explicit CallTargets(const il::Module& module);
    uint32_t target(uint32_t fnIdx, const il::Instruction& inst) const;

private:
    // A record a function holds, named by the function and the value id of
    // its `env.create` there.
    struct Record {
        uint32_t fn = UINT32_MAX;
        il::ValueId value = il::kNoValue;
    };
    static uint64_t key(Record r, uint32_t slot) {
        return (static_cast<uint64_t>(r.fn) << 40) ^ (static_cast<uint64_t>(r.value) << 16) ^ slot;
    }
    Record normalize(Record r) const;
    Record parentOf(Record r) const;

    const il::Module& module_;
    // Per function: the record its closures were created over (by its one
    // `create.func`), when there is one.
    std::vector<Record> closedOver_;
    // Per function: the defining op and operand 0 of each value, enough to
    // follow `env.get` and `env.create` chains.
    std::vector<std::vector<const il::Instruction*>> defs_;
    // (record, slot) -> the function whose closure is the only thing stored
    // there; UINT32_MAX when something else is stored too.
    std::unordered_map<uint64_t, uint32_t> slotFn_;
};

// Functions entered often: from a loop anywhere in the module (other than the
// module's top level), or from any block of a function so entered, through the
// calls `CallTargets` names; a function that calls itself from a loop of its
// own (a recursive tree walk) is entered from a loop. `closureGuesses` adds a
// site's own-callee guesses (direct_method_table.h) as calls of those
// functions.
std::vector<uint8_t> hotFunctions(const il::Module& module,
                                  const std::unordered_map<uint32_t, std::vector<uint32_t>>* closureGuesses);

}  // namespace bronze::lower
// Where guarded inlining copies bodies: the call graph's hot part
// (inline_hot.h). docs/aot-inlining.md has the measurements behind it.

#include "lower/inline_hot.h"

#include "lower/guard_region_cfg.h"

#include <cstdlib>

namespace bronze::lower {

std::vector<uint8_t> loopBlocks(const il::Function& fn) {
    std::vector<uint8_t> in(fn.blocks.size(), 0);
    if (fn.blocks.empty()) return in;
    const Cfg cfg = buildCfg(fn);
    for (size_t b = 0; b < fn.blocks.size(); ++b) {
        if (cfg.rpoIndex[b] == UINT32_MAX) continue;
        for (il::BlockId h : cfg.succs[b]) {
            if (!cfg.dominates(h, static_cast<il::BlockId>(b))) continue;
            for (il::BlockId m : naturalLoop(cfg, h, static_cast<il::BlockId>(b))) in[m] = 1;
        }
    }
    return in;
}

namespace {
constexpr uint32_t kNone = UINT32_MAX;
}  // namespace

CallTargets::CallTargets(const il::Module& module) : module_(module) {
    const size_t n = module.functions.size();
    closedOver_.assign(n, Record{});
    defs_.resize(n);
    std::vector<uint8_t> created(n, 0);
    struct Set {
        Record rec;
        uint32_t slot;
        uint32_t fn;
    };
    std::vector<Set> pendingSets;
    for (uint32_t p = 0; p < n; ++p) {
        const il::Function& fn = module.functions[p];
        defs_[p].assign(fn.valueCount, nullptr);
        for (const auto& b : fn.blocks) {
            for (const auto& inst : b.instructions) {
                if (inst.result != il::kNoValue && inst.result < fn.valueCount) defs_[p][inst.result] = &inst;
            }
        }
    }
    for (uint32_t p = 0; p < n; ++p) {
        const il::Function& fn = module.functions[p];
        for (const auto& b : fn.blocks) {
            for (const auto& inst : b.instructions) {
                if (inst.op == il::Op::CreateFunction && inst.calleeIndex < n && !inst.operands.empty()) {
                    const uint32_t f = inst.calleeIndex;
                    const Record r{p, inst.operands[0]};
                    // Created in two places: its record is not one record.
                    if (created[f] && (closedOver_[f].fn != r.fn || closedOver_[f].value != r.value)) {
                        closedOver_[f] = Record{};
                    } else if (!created[f]) {
                        closedOver_[f] = r;
                    }
                    created[f] = 1;
                }
                if (inst.op != il::Op::EnvSet || inst.envDepth != 0 || inst.operands.size() < 2) continue;
                const il::Instruction* def =
                    inst.operands[1] < defs_[p].size() ? defs_[p][inst.operands[1]] : nullptr;
                const uint32_t f = def && def->op == il::Op::CreateFunction ? def->calleeIndex : kNone;
                pendingSets.push_back({Record{p, inst.operands[0]}, inst.envIndex, f});
            }
        }
    }
    // Keyed once every function's record is known: a set through a
    // function's own parameter names its creator's record.
    for (const auto& [rec, slot, f] : pendingSets) {
        const Record r = normalize(rec);
        if (r.fn == kNone) continue;
        const auto [it, fresh] = slotFn_.emplace(key(r, slot), f);
        if (!fresh && it->second != f) it->second = kNone;
    }
}

// A record named by its function's environment parameter is the record that
// function was created over, named in its creator's terms.
CallTargets::Record CallTargets::normalize(Record r) const {
    for (int guard = 0; guard < 64 && r.fn != kNone; ++guard) {
        if (!module_.functions[r.fn].needsEnv || r.value != 0) return r;
        r = closedOver_[r.fn];
    }
    return r.fn == kNone ? r : Record{};
}

// The record one parent link above `r`: the parent operand of its
// `env.create`.
CallTargets::Record CallTargets::parentOf(Record r) const {
    r = normalize(r);
    if (r.fn == kNone || r.value == il::kNoValue) return Record{};
    const il::Instruction* def = r.value < defs_[r.fn].size() ? defs_[r.fn][r.value] : nullptr;
    if (!def || def->op != il::Op::EnvCreate || def->operands.empty()) return Record{};
    return normalize(Record{r.fn, def->operands[0]});
}

uint32_t CallTargets::target(uint32_t fnIdx, const il::Instruction& inst) const {
    switch (inst.op) {
        case il::Op::Call:
            return inst.calleeIndex < module_.functions.size() ? inst.calleeIndex : kNone;
        case il::Op::MethodCall:
        case il::Op::PropGet:
        case il::Op::PropSet:
            if (inst.directTarget == il::Instruction::kNoDirectTarget) return kNone;
            return inst.typedTarget != il::Instruction::kNoDirectTarget ? inst.typedTarget : inst.directTarget;
        case il::Op::DynamicCall: {
            if (inst.operands.empty() || fnIdx >= defs_.size()) return kNone;
            const il::Instruction* get =
                inst.operands[0] < defs_[fnIdx].size() ? defs_[fnIdx][inst.operands[0]] : nullptr;
            if (!get || (get->op != il::Op::EnvGet && get->op != il::Op::EnvGetTdz) || get->operands.empty()) {
                return kNone;
            }
            // The record read: the caller's own (an `env.create` of its
            // body, or its environment parameter, the record it closed
            // over), `envDepth` parent links up.
            Record r = normalize(Record{static_cast<uint32_t>(fnIdx), get->operands[0]});
            for (uint32_t d = 0; d < get->envDepth && r.fn != kNone; ++d) r = parentOf(r);
            if (r.fn == kNone) return kNone;
            const auto it = slotFn_.find(key(r, get->envIndex));
            return it == slotFn_.end() ? kNone : it->second;
        }
        default:
            return kNone;
    }
}

std::vector<uint8_t> hotFunctions(const il::Module& module,
                                  const std::unordered_map<uint32_t, std::vector<uint32_t>>* closureGuesses) {
    const size_t n = module.functions.size();
    const CallTargets targets(module);
    std::vector<uint8_t> hot(n, 0);
    std::vector<std::vector<uint8_t>> loops(n);
    std::vector<uint32_t> work;
    const auto mark = [&](uint32_t f) {
        if (f >= n || hot[f]) return;
        hot[f] = 1;
        work.push_back(f);
    };
    const auto skip = [&](const il::Function& fn) {
        return fn.isExternal || fn.blocks.empty() || fn.isCoroutineBody() || fn.isEntryPoint || fn.name == "main";
    };
    const auto calls = [&](uint32_t g, const il::Block& b, auto&& each) {
        for (const auto& inst : b.instructions) {
            const uint32_t t = targets.target(g, inst);
            if (t != kNone) each(t);
            if (closureGuesses && inst.op == il::Op::MethodCall) {
                if (const auto it = closureGuesses->find(inst.icIndex); it != closureGuesses->end()) {
                    for (uint32_t f : it->second) each(f);
                }
            }
        }
    };
    const bool selfOnly = std::getenv("BRONZE_TMP_HOTSELF") != nullptr;  // TEMPORARY A/B
    for (uint32_t g = 0; g < n; ++g) {
        const il::Function& fn = module.functions[g];
        if (skip(fn)) continue;
        loops[g] = loopBlocks(fn);
        for (size_t b = 0; b < fn.blocks.size(); ++b) {
            if (!loops[g][b]) continue;
            if (selfOnly) {
                calls(g, fn.blocks[b], [&](uint32_t f) { if (f == g && !hot[g]) hot[g] = 1; });
            } else {
                calls(g, fn.blocks[b], mark);
            }
        }
    }
    if (selfOnly) return hot;
    while (!work.empty()) {
        const uint32_t g = work.back();
        work.pop_back();
        const il::Function& fn = module.functions[g];
        if (skip(fn)) continue;
        for (const auto& b : fn.blocks) calls(g, b, mark);
    }
    return hot;
}

