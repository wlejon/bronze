+TEST_CASE("a family range for a cut-short key list admits every family that begins with it") {
+    // Preorder: Base {k0, k1(read-only)} -> Sub {.., k2} -> SubSub {.., k3};
+    // Other {k5}. Key indices stand for themselves.
+    il::Module mod;
+    auto fam = [&](std::vector<std::pair<uint32_t, bool>> fields) {
+        il::Module::ClassFamilyEntry e;
+        for (const auto& [k, w] : fields) e.fields.push_back(il::Module::ClassFamilyField{k, w});
+        mod.classFamilies.push_back(e);
+    };
+    fam({{0, true}, {1, false}});
+    fam({{0, true}, {1, false}, {2, true}});
+    fam({{0, true}, {1, false}, {2, true}, {3, true}});
+    fam({{5, true}});
+    uint32_t first = 0, last = 0;
+    // A whole list: the most specific family its keys hold, as the runtime picks.
+    REQUIRE(familyStampRange(mod, {0, 1, 2}, true, &first, &last));
+    CHECK((first == 1 && last == 1));
+    REQUIRE(familyStampRange(mod, {0, 1, 2, 4}, true, &first, &last));
+    CHECK((first == 1 && last == 1));
+    REQUIRE(familyStampRange(mod, {5}, true, &first, &last));
+    CHECK((first == 3 && last == 3));
+    CHECK_FALSE(familyStampRange(mod, {9}, true, &first, &last));
+    // Cut short: the shape goes on, so any longer family may be the one.
+    REQUIRE(familyStampRange(mod, {0, 1}, false, &first, &last));
+    CHECK((first == 0 && last == 2));
+    REQUIRE(familyStampRange(mod, {0}, false, &first, &last));
+    CHECK((first == 0 && last == 2));
+    CHECK_FALSE(familyStampRange(mod, {1}, false, &first, &last));
+    // A guard admits the whole range: every family in it must agree.
+    CHECK(familyRangeAgrees(mod, 0, 2, 0, 0, true));
+    CHECK(familyRangeAgrees(mod, 0, 2, 1, 1, false));
+    CHECK_FALSE(familyRangeAgrees(mod, 0, 2, 1, 1, true));  // read-only: no store
+    CHECK(familyRangeAgrees(mod, 1, 2, 2, 2, true));
+    CHECK_FALSE(familyRangeAgrees(mod, 0, 2, 2, 2, false));  // Base has no slot 2
+    CHECK_FALSE(familyRangeAgrees(mod, 0, 3, 0, 0, false));  // Other puts k5 there
+    CHECK_FALSE(familyRangeAgrees(mod, 2, 4, 0, 0, false));  // past the table
+}
